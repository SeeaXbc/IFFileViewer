[
  {
    "name": "受注IF",
    "match": "IF_ORDER_*",
    "delimiter": ",",
    "encoding": "shift_jis",
    "headers": [
      ["顧客ID", "受注日", "金額", "区分", "備考"],
      ["必須", "YYYYMMDD", "整数", "1=通常/2=返品", "任意"]
    ],
    "details": [
      "顧客マスタのID。数字8桁固定・先頭0埋め。\n存在しないIDは取込エラーとなる。",
      "受注日。YYYYMMDD形式（例: 20260401）。\n未来日付は不可。",
      "税込金額。整数のみ（カンマ・小数点不可）。\nマイナスは返品時のみ許容。",
      "受注区分。1=通常 / 2=返品。\nそれ以外の値は取込エラー。",
      "備考（任意）。全角100文字まで。"
    ]
  },
  {
    "name": "出荷IF",
    "match": "IF_SHIP_*",
    "delimiter": "\t",
    "encoding": "utf-8",
    "headers": [
      ["出荷ID", "出荷日", "倉庫", "数量"]
    ],
    "details": [
      "出荷伝票のID。英数字10桁。",
      "出荷日。YYYYMMDD形式。",
      "出荷元倉庫コード。倉庫マスタ参照。",
      "出荷数量。正の整数のみ。"
    ]
  },
  {
    "name": "在庫IF",
    "match": "IF_STOCK_*",
    "delimiter": ",",
    "encoding": "euc-jp",
    "headers": [
      ["品番", "品名", "在庫数"]
    ]
  }
]
