[
  {
    "name": "（定義の表示名。ヘッダー定義セレクトに出ます）",
    "match": "IF_XXXX_*",
    "delimiter": ",",
    "encoding": "shift_jis",
    "headers": [
      ["列1の名前", "列2の名前", "列3の名前"],
      ["補足行（不要なら行ごと削除）", "", ""]
    ],
    "details": [
      "列1の詳細説明（ヘッダーのマウスオーバーで表示。不要なら details ごと削除）",
      "列2の詳細説明。\\n で複数行にできます。",
      ""
    ],
    "rules": [
      { "col": 1, "required": true },
      { "col": 2, "type": "date" },
      { "col": 3, "type": "number", "pattern": "^[0-9]{1,8}$" }
    ]
  }
]
