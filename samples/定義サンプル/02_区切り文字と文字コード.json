[
  {
    "name": "出荷IF（タブ区切り・UTF-8）",
    "match": "IF_SHIP_*",
    "delimiter": "\t",
    "encoding": "utf-8",
    "headers": [
      ["出荷ID", "出荷日", "倉庫", "数量"]
    ]
  },
  {
    "name": "在庫IF（カンマ区切り・EUC-JP）",
    "match": "IF_STOCK_*",
    "delimiter": ",",
    "encoding": "euc-jp",
    "headers": [
      ["品番", "品名", "在庫数"]
    ]
  },
  {
    "name": "複数文字の区切りの例（@@区切り）",
    "match": "任意区切り*",
    "delimiter": "@@",
    "encoding": "utf-8",
    "headers": [
      ["コード", "名称", "数量", "備考"]
    ]
  }
]
